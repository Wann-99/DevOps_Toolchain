# 复制为 .env 后由 docker compose 自动加载（可选）
# cp .env.example .env

# 药库配置目录（宿主机路径，挂载到容器 /data/config_pnp）
CONFIG_PNP_DIR=/home/nvidia/compiled/PNPApp_deploy/config_pnp

# 知识库根目录（宿主机 templates 路径，挂载到容器 /data/knowledge）
# 默认加载根目录下的 knowledge；页面可填写根目录下其他相对目录。
KNOWLEDGE_DIR=/home/nvidia/compiled/VfmApp_deploy/model/templates
