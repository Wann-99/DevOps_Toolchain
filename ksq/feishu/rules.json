{
  "version": 1,
  "default_rule": "robot_test",
  "rules": {
    "robot_test": {
      "name": "功能测试表单规则",
      "fields": {
        "case_id": ["测试用例ID", "测试用例id", "case_id"],
        "start_time": [
          "测试时间",
          "测试开始时间",
          "测试开始时间（精确到日志的秒）"
        ],
        "end_time": [
          "测试结束时间",
          "整体测试结束时间（精确到秒）"
        ],
        "task_id": ["task_id", "任务ID", "任务 id"],
        "screenshot": [
          "截图",
          "问题截图",
          "问题截图/视频",
          "错误日志截图和机器拍照"
        ],
        "problem_description": ["问题现象描述", "问题描述"],
        "error_category": ["错误原因归类", "错误原因分类", "一级分类"],
        "error_subcategory": ["错误原因小类", "错误小类", "二级分类"]
      },
      "sku_stages": {
        "recognize": ["识别"],
        "pick": ["抓取", "吸取"],
        "scan": ["扫码"],
        "outbound": ["出库"],
        "place": ["放置"]
      },
      "sku_tool": ["末端工具"],
      "option_aliases": {
        "sku_tool": {
          "double_vacuum_gripper": ["双吸盘"],
          "quad_vacuum_gripper": ["四吸盘"],
          "four_vacuum_gripper": ["四吸盘"],
          "gripper": ["夹爪"],
          "vacuum_gripper": ["双吸盘"],
          "tool_exchange_failed": ["工具切换失败"]
        },
        "error_category": {
          "无异常": ["成功"],
          "视觉识别异常": ["算法问题"],
          "抓取异常": ["算法问题"],
          "扫码异常": ["算法问题"],
          "放置异常": ["算法问题"],
          "导航异常": ["系统问题"],
          "通信异常": ["系统问题"],
          "软件逻辑异常": ["软件问题"],
          "硬件异常": ["硬件问题"],
          "环境异常": ["运营规范"],
          "未知": ["待归因"]
        },
        "error_subcategory": {
          "OCR识别失败": ["感知/识别"],
          "SKU识别失败": ["感知/识别"],
          "吸盘漏气": ["算法-闭环吸取"],
          "抓取失败": ["算法-闭环吸取"],
          "真空检测失败": ["算法-闭环吸取"],
          "扫码超时": ["扫码问题"],
          "扫码失败": ["扫码问题"],
          "二维码损坏": ["扫码问题"],
          "导航超时": ["底盘定位导航"],
          "定位失败": ["底盘定位导航"],
          "放置失败": ["打包流程问题"],
          "机械臂碰撞": ["机械臂问题"],
          "网络超时": ["系统问题-其他"],
          "通信超时": ["系统问题-其他"],
          "软件异常": ["软件问题-其他"],
          "无异常": ["成功"],
          "其它": ["其他"]
        }
      }
    }
  }
}
